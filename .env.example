# Copia questo file in `.env` (stessa cartella) e riempi i valori.
# `.env` è già in .gitignore: le chiavi NON finiscono nel repo.
# Caricato automaticamente da config/settings.py all'import.

# ── DeepSeek (estrattore LLM di triple) ──────────────────────────────
# Chiave da https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Neo4j ────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ── Corpus ALCE ──────────────────────────────────────────────────────
ALCE_DATA_PATH=D:\python_projects\rag\ALCE\data\asqa_eval_gtr_top100_reranked_oracle.json

# ── Estrattore usato di default nelle query di attribution ───────────
ACTIVE_EXTRACTOR=rebel
