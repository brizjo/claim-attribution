# Copia questo file in `.env` (stessa cartella) e riempi i valori.
# `.env` è già in .gitignore: le chiavi NON finiscono nel repo.
# Caricato automaticamente da config/settings.py all'import.

# ── DeepSeek (estrattore LLM di triple) ──────────────────────────────
# Chiave da https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Neo4j ────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ── Corpus ALCE ──────────────────────────────────────────────────────
ALCE_DATA_PATH=D:\python_projects\rag\ALCE\data\asqa_eval_gtr_top100_reranked_oracle.json

# ── Estrattore della pipeline (unico: deepseek) ──────────────────────
# Filtra anche gli archi interrogati in attribution: metterlo a `rebel`
# interroga un grafo vecchio, scritto da un estrattore che non e' piu' nella
# pipeline.
ACTIVE_EXTRACTOR=deepseek

# ── Canonicalizzazione delle entita' (fase fra estrazione e scrittura) ─
# Scope di unificazione dei nodi: per_passage | per_question | global.
# per_question e' il default: unifica dentro la domanda ALCE e i suoi 5
# passaggi.  per_passage lascia la stessa entita' come nodi distinti;
# global collassa gli omonimi di domande diverse (usarlo solo per ablazione,
# dichiarandolo come limite).
CANONICALIZATION_SCOPE=per_question

# Stadio 3 (entity linking): title | spotlight | none.
# "title" usa il titolo Wikipedia del passaggio ALCE — deterministico e
# offline.  "spotlight" aggiunge DBpedia Spotlight via rete: se il servizio
# non risponde lo stadio degrada (con log) sull'embedding.
ENTITY_LINKER=title

# ── UI ────────────────────────────────────────────────────────────────
# Tab degli esperimenti (pipeline ibrida REBEL+DeepSeek, tabelle A/D, cache
# LLM): strumenti di sviluppo, nascosti per default. 1 per mostrarlo.
SHOW_EXPERIMENTS=0
